# Cloudflare Pages headers.
#
# The asset filenames carry a content hash, so they may be cached forever - a changed build gets a
# changed name. The two things that keep their names must not be:
#
#   index.html    is how a reader reaches every new build at all;
#   data/*.json   is the registry and the passports. A verdict that expires by time, sitting behind
#                 a week-long cache, would show a reader a document the issuer has already
#                 superseded. This project's own rule is that the served artefact is the artefact.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

# RFC 8288 Link headers, on every page, pointing at the two documents this project asks to be
# found by regardless of which page a crawler entered on: the registry (the same relation
# `rel="alternate"` already used on <link> in the page head, so a crawler reading only headers and
# one reading the HTML learn the same thing) and the RFC 9727 API catalog, whose own registered
# relation type is `api-catalog`.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Link: <https://provek.dev/data/registry.json>; rel="alternate"; type="application/json", <https://provek.dev/.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

# RFC 9727 requires this exact media type; a static file with no extension would otherwise be
# served as octet-stream and an RFC-aware reader would refuse to parse it.
/.well-known/api-catalog
  Content-Type: application/linkset+json

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# ARD (Agentic Resource Discovery) manifest. JSON, and CORS-open like the rest of the machine-
# readable surface (the registry and every passport are meant to be fetched cross-origin by an
# agent, not just read same-origin by this site's own pages).
/.well-known/ai-catalog.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
