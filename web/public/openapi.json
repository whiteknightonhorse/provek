{
  "openapi": "3.1.0",
  "info": {
    "title": "Provek",
    "version": "1.0.0",
    "description": "The routes provek.dev serves to a program: two static JSON resources, one intake write with its status read, one relay write for the GenLayer Evidence Witness, a badge and a one-page brief per passport. Authentication: none (see /auth.md); nothing here is gated. This file is generated by web/openapi.mjs and held to the Function sources by tests; \"version\" is the version of this description, not of a service."
  },
  "servers": [
    {
      "url": "https://provek.dev"
    }
  ],
  "paths": {
    "/data/registry.json": {
      "get": {
        "summary": "The registry: every subject submitted and what could be established about each.",
        "operationId": "getRegistry",
        "responses": {
          "200": {
            "description": "The registry document. Served as a static file; refreshed daily.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registry"
                }
              }
            }
          }
        }
      }
    },
    "/data/passports/{slug}.json": {
      "get": {
        "summary": "The autonomy passport of one subject.",
        "operationId": "getPassport",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Passport slug: the subject_id with ':' and '/' replaced by '_', as listed in /data/registry.json and /llms.txt.",
            "schema": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The passport document. CORS-open.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PassportDocument"
                }
              }
            }
          },
          "404": {
            "description": "No passport under this slug.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/apply": {
      "post": {
        "summary": "Submit a public GitHub repository for verification. Anonymous.",
        "description": "Needs the repository owner's consent, given inside the request. Limited per IP at the edge (5 per 10 s): over the limit the edge answers 429 with an HTML body, not JSON, before this handler runs; wait 10 seconds and retry. The handler does not check Origin; the OPTIONS answer carries no Access-Control-Allow-Origin, so a browser accepts this write from the site's own pages only.",
        "operationId": "postApply",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded. `delivered` says whether the operator's notice went out. A submission whose `website` honeypot field is non-empty also answers 200, with id \"ignored\" and no record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyAccepted"
                }
              }
            }
          },
          "400": {
            "description": "The body could not be read, or a field failed validation; `error` names which.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "The content-type is not application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Edge rate limit. An HTML body, not JSON; never produced by the handler.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Intake storage is not configured on this deployment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Not a reading: answers 405.",
        "operationId": "getApply",
        "responses": {
          "405": {
            "description": "This endpoint accepts a submission, not a reading.",
            "headers": {
              "Allow": {
                "description": "POST",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "Preflight or probe: says what the endpoint accepts.",
        "operationId": "optionsApply",
        "responses": {
          "204": {
            "description": "No body. `Allow: POST, OPTIONS`, `Access-Control-Allow-Methods: POST`."
          }
        }
      }
    },
    "/api/apply/{id}": {
      "get": {
        "summary": "The state of one request, by the id POST /api/apply returned.",
        "description": "The id is a random UUID only the applicant holds: it is the read capability. The contact address, user agent, country and consent fields are never returned.",
        "operationId": "getApplyStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id from the POST /api/apply answer.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request's state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyStatus"
                }
              }
            }
          },
          "404": {
            "description": "The id is malformed or unknown.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyLookupFailure"
                }
              }
            }
          },
          "500": {
            "description": "An index entry exists but its record is gone or unreadable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyLookupFailure"
                }
              }
            }
          },
          "503": {
            "description": "The intake store is not configured or could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyLookupFailure"
                }
              }
            }
          }
        }
      }
    },
    "/api/witness-submit": {
      "x-any-other-method": {
        "description": "Any method other than GET and POST.",
        "responses": {
          "405": {
            "description": "Use GET for status or POST to submit.",
            "headers": {
              "Allow": {
                "description": "GET, POST",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Whether the GenLayer Evidence Witness relay is enabled, with its limits.",
        "operationId": "getWitnessRelay",
        "responses": {
          "200": {
            "description": "Relay status. `enabled` is false when the operator secret or the rate-limit store is missing; `reason` then says which.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WitnessRelayStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Ask the Evidence Witness contract for a check, signed by the operator key. Anonymous.",
        "description": "Same-origin only: a request carrying a different Origin is refused with 403. The body is at most 8192 bytes. Limits: 3 per client per hour and 50 per UTC day for the whole service. The relay signs and sends; the verdict is produced by GenLayer validators and read back from the chain (/witness/).",
        "operationId": "postWitnessSubmit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WitnessRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sent. The transaction is not yet decided; follow `track_url`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WitnessAccepted"
                }
              }
            }
          },
          "400": {
            "description": "The body is too large or not JSON, or a field failed the contract's own rules; `field` and `reason` say which.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WitnessRefused"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin submission.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "A rate limit is reached.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limit resets.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WitnessRateLimited"
                }
              }
            }
          },
          "502": {
            "description": "The GenLayer network or client refused the request; upstream text with any key material removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Submissions are disabled (secret or KV binding missing), the rate limiter cannot be read, or the operator wallet holds less than the deposit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/badge/{slug}.svg": {
      "get": {
        "summary": "A status badge for one passport, as SVG.",
        "description": "`?plain=1` renders status and expiry without the projection number. An unknown or unreadable slug still answers 200, with an SVG that says so.",
        "operationId": "getBadge",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Passport slug: the subject_id with ':' and '/' replaced by '_', as listed in /data/registry.json and /llms.txt.",
            "schema": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          },
          {
            "name": "plain",
            "in": "query",
            "required": false,
            "description": "`1` drops the projection row.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The badge.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The path did not end in .svg.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Not a submission: answers 405.",
        "operationId": "postBadge",
        "responses": {
          "405": {
            "description": "This endpoint answers a reading, not a submission.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/p/{slug}/brief": {
      "get": {
        "summary": "A one-page HTML brief of one passport.",
        "operationId": "getBrief",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Passport slug: the subject_id with ':' and '/' replaced by '_', as listed in /data/registry.json and /llms.txt.",
            "schema": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The brief.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "The slug is not a subject identifier, or nothing has been issued under it.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "The record could not be read.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Not a submission: answers 405.",
        "operationId": "postBrief",
        "responses": {
          "405": {
            "description": "This endpoint answers a reading, not a submission.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Registry": {
        "type": "object",
        "description": "Only the fields the site's own code reads are listed; the document carries more.",
        "properties": {
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "subject_id"
              ],
              "properties": {
                "subject_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PassportDocument": {
        "type": "object",
        "description": "Only the fields the site's own code reads are listed; the document carries more.",
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "passport": {
            "type": "object",
            "properties": {
              "subject_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "valid_until": {
                "type": "string"
              }
            }
          }
        }
      },
      "ApplyRequest": {
        "type": "object",
        "required": [
          "repo",
          "contact",
          "mandate",
          "consent"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 160,
            "description": "A public GitHub repository URL, https://github.com/<owner>/<name>."
          },
          "contact": {
            "type": "string",
            "maxLength": 254,
            "description": "An address we could reply to."
          },
          "mandate": {
            "type": "string",
            "enum": [
              "passive",
              "active"
            ],
            "description": "What the applicant asks for. Recorded as asked; the applied policy is always passive."
          },
          "consent": {
            "type": "boolean",
            "description": "Optional product-updates answer; not a condition of the request. Must be true or false, never omitted."
          },
          "consent_version": {
            "type": "string",
            "const": "updates-1.1.0",
            "description": "Required when consent is true: the wording version the applicant was shown."
          },
          "origin": {
            "type": "string",
            "enum": [
              "challenge"
            ],
            "description": "Set only by the /challenge/ link."
          },
          "website": {
            "type": "string",
            "description": "Honeypot. Leave empty."
          }
        }
      },
      "ApplyAccepted": {
        "type": "object",
        "required": [
          "ok",
          "id"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "id": {
            "type": "string",
            "description": "A UUID: the read capability for GET /api/apply/{id}. \"ignored\" for a honeypot submission."
          },
          "delivered": {
            "type": "boolean",
            "description": "Whether the operator's notice was delivered. Absent for a honeypot submission."
          }
        }
      },
      "ApplyStatus": {
        "type": "object",
        "required": [
          "ok",
          "id",
          "state"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "description": "One of received, deferred, refused, published, withdrawn; any other value is reported as unknown_outcome:<value>."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_attempt_after": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set only for a deferred request."
          },
          "registry_url": {
            "type": "string",
            "description": "The passport page when published, else /registry/."
          }
        }
      },
      "ApplyLookupFailure": {
        "type": "object",
        "required": [
          "ok",
          "state"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "state": {
            "type": "string",
            "enum": [
              "no_such_request",
              "status_unavailable",
              "record_missing"
            ]
          }
        }
      },
      "WitnessRequest": {
        "type": "object",
        "required": [
          "subject_id",
          "criterion",
          "evidence_url"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "criterion": {
            "type": "string",
            "enum": [
              "url_reachable",
              "artifact_hash"
            ]
          },
          "evidence_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "http or https, a host, no userinfo, no whitespace or control characters."
          },
          "expected": {
            "type": "string",
            "description": "A 64-character hex sha256 for artifact_hash; must be empty or absent for url_reachable."
          }
        }
      },
      "WitnessAccepted": {
        "type": "object",
        "required": [
          "tx_hash",
          "explorer_url",
          "track_url"
        ],
        "properties": {
          "tx_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "explorer_url": {
            "type": "string"
          },
          "track_url": {
            "type": "string",
            "description": "Relative: /witness/?tx=<tx_hash>."
          }
        }
      },
      "WitnessRefused": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "Present when a field failed validation."
          },
          "error": {
            "type": "string"
          }
        }
      },
      "WitnessRateLimited": {
        "type": "object",
        "required": [
          "ok",
          "limit",
          "retry_after_seconds",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "limit": {
            "type": "string",
            "enum": [
              "per_ip_per_hour",
              "per_day_global"
            ]
          },
          "retry_after_seconds": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "WitnessRelayStatus": {
        "type": "object",
        "required": [
          "enabled",
          "operator",
          "contract",
          "funded",
          "fee_quote",
          "limits"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "operator": {
            "type": [
              "string",
              "null"
            ],
            "description": "The operator address; null when it could not be derived."
          },
          "contract": {
            "type": "string"
          },
          "funded": {
            "description": "true or false when the wallet balance was read, else \"not_measured\".",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "not_measured"
              }
            ]
          },
          "fee_quote": {
            "type": "string",
            "description": "The deposit in GEN, or \"not_measured\"."
          },
          "limits": {
            "type": "object",
            "required": [
              "per_ip_per_hour",
              "per_day_global"
            ],
            "properties": {
              "per_ip_per_hour": {
                "type": "integer",
                "const": 3
              },
              "per_day_global": {
                "type": "integer",
                "const": 50
              }
            }
          },
          "reason": {
            "type": "string",
            "description": "Present when the relay is disabled or the operator address could not be derived."
          }
        }
      }
    }
  }
}
