# Cloudflare Pages headers.
#
# The asset filenames carry a content hash, so they may be cached forever - a changed build gets a
# changed name. The two things that keep their names must not be:
#
#   index.html    is how a reader reaches every new build at all;
#   data/*.json   is the registry and the passports. A verdict that expires by time, sitting behind
#                 a week-long cache, would show a reader a document the issuer has already
#                 superseded. This project's own rule is that the served artefact is the artefact.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Link-preview crawlers refetch the share image on their own schedule; a day's cache is enough for
# a file that changes with a card, and the hash gate in tests is what keeps the bytes honest.
/og-image.png
  Cache-Control: public, max-age=86400

# RFC 8288 Link headers, on every page, pointing at the two documents this project asks to be
# found by regardless of which page a crawler entered on: the registry (the same relation
# `rel="alternate"` already used on <link> in the page head, so a crawler reading only headers and
# one reading the HTML learn the same thing) and the RFC 9727 API catalog, whose own registered
# relation type is `api-catalog`.
#
# SECURITY HEADERS (T-0579). The Content-Security-Policy is measured, not guessed:
# `python3 scripts/csp_inventory.py` walks web/dist and lists what the pages load, and
# tests/test_csp_covers_what_the_pages_load.py holds this block to that list in both directions
# (a loaded origin that the policy omits fails; an origin the policy allows that nothing loads fails).
#
#   script-src    has no 'unsafe-inline' (T-0579b). prerender.mjs writes the bootstrap as a JSON data
#                 block (`<script type="application/json" id="provek-bootstrap">`), which the browser
#                 never executes, so nothing needs a hash. The test goes red if an executable inline
#                 script returns while the policy lacks the allowance, or the allowance returns without one.
#   style-src 'unsafe-inline'  the pages carry style="..." attributes (25 of 31 pages, measured).
#   img-src / frame-src       the YouTube facade: the poster comes from i.ytimg.com, the player from
#                 youtube-nocookie.com after a click.
#   connect-src               the Cloudflare beacon reports to cloudflareinsights.com; the witness page
#                 reads the Bradbury RPC straight from the browser (witnessChainConfig.js RPC_URL).
#   Strict-Transport-Security has no `preload`: that is an operator decision, not a header default.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://rpc-bradbury.genlayer.com; img-src 'self' https://i.ytimg.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Link: <https://provek.dev/data/registry.json>; rel="alternate"; type="application/json", <https://provek.dev/.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

# RFC 9727 requires this exact media type; a static file with no extension would otherwise be
# served as octet-stream and an RFC-aware reader would refuse to parse it.
/.well-known/api-catalog
  Content-Type: application/linkset+json

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# ARD (Agentic Resource Discovery) manifest. JSON, and CORS-open like the rest of the machine-
# readable surface (the registry and every passport are meant to be fetched cross-origin by an
# agent, not just read same-origin by this site's own pages).
/.well-known/ai-catalog.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# Agent Skills Discovery index (RFC v0.2.0). JSON, CORS-open like the other discovery maps.
/.well-known/agent-skills/index.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# OpenAPI 3.1 description of the routes this site serves (generated by web/openapi.mjs, D-83).
# JSON, and CORS-open like the other machine-readable documents.
/openapi.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# The statement of this site's authentication. A static .md would otherwise depend on the host's
# default type.
/auth.md
  Content-Type: text/markdown; charset=utf-8
